<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>

<MenuBar xmlns="http://javafx.com/javafx/8"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.mongraphe.graphui.controller.MainMenuController">

    <Menu text="Fichier">
        <MenuItem text="Nouveau projet"
                  onAction="#handleNewProject"/>
        <MenuItem text="Fermer l'espace de travail"
                  onAction="#handleCloseWorkspace"/>
        <SeparatorMenuItem/>
        <MenuItem text="Quitter"
                  onAction="#handleQuit"/>
    </Menu>

    <Menu text="Aide">
        <MenuItem text="À propos"
                  onAction="#handleAbout"/>
    </Menu>

</MenuBar>