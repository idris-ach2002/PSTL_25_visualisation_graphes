<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mongraphe.graphui.controller.MainController"
            fx:id="root">

    <!-- TOP -->
    <top>
        <fx:include source="MainMenuView.fxml"/>
    </top>

    <!-- LEFT -->
    <left>
        <VBox spacing="15">
            <fx:include source="GraphWorkspaceView.fxml"/>
            <fx:include source="EngineOptionsView.fxml"/>
        </VBox>
    </left>

    <!-- CENTER -->
    <center>
        <fx:include source="CenterView.fxml"/>
    </center>

</BorderPane>