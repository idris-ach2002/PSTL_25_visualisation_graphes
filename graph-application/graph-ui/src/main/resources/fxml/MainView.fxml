<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="com.mongraphe.graphui.controller.MainGraphController"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox>
            <fx:include source="MainMenuView.fxml" fx:id="menuView"/>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:5;">
                <fx:define>
                    <ToggleGroup fx:id="viewToggleGroup"/>
                </fx:define>

                <ToggleButton text="Overview"
                              toggleGroup="$viewToggleGroup"
                              userData="overview"
                              selected="true"
                              onAction="#handleViewChange"/>

                <ToggleButton text="Data"
                              toggleGroup="$viewToggleGroup"
                              userData="data"
                              onAction="#handleViewChange"/>

                <ToggleButton text="Preview"
                              toggleGroup="$viewToggleGroup"
                              userData="preview"
                              onAction="#handleViewChange"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:0 5 5 5;">
                <fx:define>
                    <ToggleGroup fx:id="toolToggleGroup"/>
                </fx:define>

                <Label text="Outils:"/>
                <ToggleButton text="Run" toggleGroup="$toolToggleGroup" userData="RUN" selected="true"/>
                <ToggleButton text="Select" toggleGroup="$toolToggleGroup" userData="SELECT"/>
                <ToggleButton text="Move" toggleGroup="$toolToggleGroup" userData="MOVE"/>
                <ToggleButton text="Delete" toggleGroup="$toolToggleGroup" userData="DELETE"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="rootStack">

            <BorderPane fx:id="overview">
                <left>
                    <ScrollPane fitToWidth="true" prefWidth="340">
                        <VBox spacing="15">
                            <fx:include source="GraphWorkspaceView.fxml" fx:id="workspaceView"/>
                            <fx:include source="EngineOptionsView.fxml" fx:id="engineOptionsView"/>
                        </VBox>
                    </ScrollPane>
                </left>

                <center>
                    <StackPane fx:id="graphHostPane" style="-fx-background-color: white;"/>
                </center>

                <right>
                    <fx:include source="GraphStats.fxml" fx:id="graphStats" visible="true"/>
                </right>
            </BorderPane>

            <fx:include source="DataView.fxml" fx:id="dataView" visible="false"/>

            <Pane fx:id="preview" visible="false" style="-fx-background-color:white;">
                <children>
                    <Label text="Prévisualisation à venir" layoutX="20" layoutY="20"/>
                </children>
            </Pane>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 6; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
            <Label text="Statut:" style="-fx-font-weight: bold;"/>
            <Label fx:id="statusLabel" text="Prêt"/>
        </HBox>
    </bottom>

</BorderPane>
