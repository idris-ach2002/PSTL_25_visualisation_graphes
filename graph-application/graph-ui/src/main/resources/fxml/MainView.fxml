<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="com.mongraphe.graphui.controller.MainGraphController"
    xmlns="http://javafx.com/javafx/8" stylesheets="@../styles/gephi_like.css"
    xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox>
            <fx:include source="MainMenuView.fxml" fx:id="menuView"/>

            <HBox fx:id="toolsBox" spacing="10" alignment="CENTER_LEFT" style="-fx-padding:5 5 5 5;">
                <fx:define>
                    <ToggleGroup fx:id="toolToggleGroup"/>
                </fx:define>
                <Label text="Outils:"/>
                <HBox fx:id="toolBar" spacing="5" styleClass="tool-bar">
                    <ToggleButton text="Select" toggleGroup="$toolToggleGroup" userData="SELECT" selected="true"/>
                    <ToggleButton text="Move" toggleGroup="$toolToggleGroup" userData="MOVE"/>
                    <ToggleButton text="Delete" toggleGroup="$toolToggleGroup" userData="DELETE"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER">
                    <Button text="+" onAction="#zoomIn" />
                    <Button text="-" onAction="#zoomOut" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="rootTabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Overview" closable="false">
                <BorderPane fx:id="overview">
                    <left>
                        <ScrollPane fitToWidth="true" prefWidth="340">
                            <VBox spacing="15">
                                <fx:include source="GraphWorkspaceView.fxml" fx:id="workspaceView"/>
                                <fx:include source="EngineOptionsView.fxml" fx:id="engineOptionsView"/>
                            </VBox>
                        </ScrollPane>
                    </left>
                    <center>
                        <StackPane fx:id="graphHostPane" style="-fx-background-color: white;"/>
                    </center>
                    <right>
                        <fx:include source="GraphStats.fxml" fx:id="graphStats" visible="true"/>
                    </right>
                </BorderPane>
            </Tab>
            <Tab text="Data" closable="false">
                <fx:include source="DataView.fxml" fx:id="dataView" />
            </Tab>
            <Tab text="Preview" closable="false">
                <fx:include source="Preview.fxml" fx:id="preview" />
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 6; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
            <Label text="Statut:" style="-fx-font-weight: bold;"/>
            <Label fx:id="statusLabel" text="Prêt"/>
        </HBox>
    </bottom>

</BorderPane>