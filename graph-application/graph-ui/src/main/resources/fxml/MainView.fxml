<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="com.mongraphe.graphui.controller.MainGraphController"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox>
            <fx:include source="MainMenuView.fxml" fx:id="menuView"/>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:5;">
                <fx:define>
                    <ToggleGroup fx:id="viewToggleGroup"/>
                </fx:define>

                <ToggleButton text="Overview"
                              toggleGroup="$viewToggleGroup"
                              userData="overview"
                              selected="true"
                              onAction="#handleViewChange"/>

                <ToggleButton text="Data"
                              toggleGroup="$viewToggleGroup"
                              userData="data"
                              onAction="#handleViewChange"/>

                <ToggleButton text="Preview"
                              toggleGroup="$viewToggleGroup"
                              userData="preview"
                              onAction="#handleViewChange"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:0 5 5 5;">
                <fx:define>
                    <ToggleGroup fx:id="toolToggleGroup"/>
                </fx:define>

                <Label text="Outils:"/>
                <ToggleButton fx:id="toolRun" text="Run" toggleGroup="$toolToggleGroup" userData="RUN" selected="true"/>
                <ToggleButton fx:id="toolSelect" text="Select" toggleGroup="$toolToggleGroup" userData="SELECT"/>
                <ToggleButton fx:id="toolMove" text="Move" toggleGroup="$toolToggleGroup" userData="MOVE"/>
                <ToggleButton fx:id="toolDelete" text="Delete" toggleGroup="$toolToggleGroup" userData="DELETE"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="rootStack">

            <BorderPane fx:id="overview">
                <left>
                    <ScrollPane fitToWidth="true" prefWidth="340">
                        <VBox spacing="15">
                            <fx:include source="GraphWorkspaceView.fxml" fx:id="workspaceView"/>
                            <fx:include source="EngineOptionsView.fxml" fx:id="engineOptionsView"/>
                        </VBox>
                    </ScrollPane>
                </left>

                <center>
                    <StackPane fx:id="graphHostPane" style="-fx-background-color: white;"/>
                </center>

                <right>
                    <VBox fx:id="statsPane" spacing="8" style="-fx-padding: 10; -fx-border-color: lightgray; -fx-border-width: 0 0 0 1;" prefWidth="280">
                        <Label text="Statistiques" style="-fx-font-size: 15; -fx-font-weight: bold;"/>

                        <GridPane hgap="8" vgap="4">
                            <Label text="Nœuds affichés:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="nodesDisplayedLabel" text="0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Nœuds cachés:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="nodesHiddenLabel" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Nœuds supprimés:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="nodesDeletedLabel" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Arêtes affichées:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="edgesDisplayedLabel" text="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Arêtes cachées:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="edgesHiddenLabel" text="0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Total éléments:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <Label fx:id="totalElementsLabel" text="0" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Separator/>
                        <Label text="Seuils" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="8" vgap="4">
                            <Label text="Seuil conseillé:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="recommendedThresholdLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Anti-seuil conseillé:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="recommendedAntiThresholdLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Separator/>
                        <Label text="Sélection" style="-fx-font-weight: bold;"/>
                        <GridPane hgap="8" vgap="4">
                            <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="selectedVertexIdLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="X:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="selectedVertexXLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Y:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="selectedVertexYLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>
                </right>
            </BorderPane>

            <fx:include source="DataView.fxml" fx:id="dataView" visible="false"/>

            <Pane fx:id="preview" visible="false" style="-fx-background-color:white;">
                <children>
                    <Label text="Prévisualisation à venir" layoutX="20" layoutY="20"/>
                </children>
            </Pane>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 6; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
            <Label text="Statut:" style="-fx-font-weight: bold;"/>
            <Label fx:id="statusLabel" text="Prêt"/>
        </HBox>
    </bottom>

</BorderPane>
