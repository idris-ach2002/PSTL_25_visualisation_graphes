<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/8"
  xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mongraphe.graphui.controller.EngineOptionsController" spacing="12">

  <Label text="Paramètres dynamiques" style="-fx-font-weight: bold; -fx-text-fill: #2a6496;"/>
  <Label text="Ces valeurs peuvent être modifiées pendant la simulation sans redémarrage." style="-fx-font-size: 11; -fx-text-fill: #666;" wrapText="true"/>

  <GridPane hgap="10" vgap="8">
    <Label text="Friction :" />
    <TextField fx:id="frictionField" promptText="0.1" GridPane.columnIndex="1"/>

    <Label text="Attraction :" GridPane.rowIndex="1"/>
    <TextField fx:id="attractionCoeffField" promptText="10" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Répulsion intra-zone :" GridPane.rowIndex="2"/>
    <TextField fx:id="repulsionCoeffField" promptText="10" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Répulsion anti-arêtes :" GridPane.rowIndex="3"/>
    <TextField fx:id="antiRepulsionField" promptText="50" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Amortissement :" GridPane.rowIndex="4"/>
    <TextField fx:id="amortissementField" promptText="0.999" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Mode répulsion :" GridPane.rowIndex="5"/>
    <ComboBox fx:id="repulsionModeCombo" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="160"/>
  </GridPane>

  <HBox alignment="CENTER_RIGHT">
    <Button text="Appliquer" onAction="#applyOptions"/>
  </HBox>
</VBox>